<Page x:Class="PLCMonitorSystem.UI.PgEthernet"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PLCMonitorSystem.UI"
      mc:Ignorable="d" 
      d:DesignHeight="658" d:DesignWidth="1366"
      Title="PgEthernet"
      Background="AliceBlue">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="SETTING"
               FontSize="40"
               FontWeight="Bold">
            
        </Label>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Label Content="RUN SETTING" FontSize="20" FontWeight="Bold"></Label>
                    <Button x:Name="btnSaveAppSetting" Content="SAVE" Width="50" Margin="10 10 0 10"></Button>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <UniformGrid Rows="4" Columns="2">
                        <Label Content="Word Device"></Label>
                        <TextBox x:Name="tbxWord" Text="D100" Margin="-76 0 0 0" VerticalAlignment="Center"></TextBox>
                        <Label Content="Bit Device"></Label>
                        <TextBox x:Name="tbxBit" Text="M100" Margin="-76 0 0 0" VerticalAlignment="Center"></TextBox>
                        <Label Content="Cycle"></Label>
                        <TextBox x:Name="tbxCycle" Text="0" Margin="-76 0 0 0" VerticalAlignment="Center"></TextBox>
                    </UniformGrid>
                </StackPanel>


            </Grid>

        </Grid>
    </Grid>
</Page>

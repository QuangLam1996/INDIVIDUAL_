<Page x:Class="PLCMonitorSystem.UI.PgAlarm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PLCMonitorSystem.UI"
      mc:Ignorable="d" 
      d:DesignHeight="658" d:DesignWidth="1366"
      Title="PgAlarm">

    <Grid Background="#dddddd">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2"></RowDefinition>
                <RowDefinition Height="150"></RowDefinition>
                <RowDefinition Height="300"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="Background" Value="RoyalBlue"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="2,2,2,2"/>
                        <Setter Property="Padding" Value="0,0,0,0"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="Foreground" Value="RoyalBlue"/>
                        <Setter Property="FontSize" Value="20"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0">Time</Label>
                <Label Grid.Row="1" Grid.Column="0">Code</Label>
                <Label Grid.Row="2" Grid.Column="0">SEQID</Label>

                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtTime"
                     Background="Black" Foreground="Green"></TextBox>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCode"></TextBox>

                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="txtSeqId"></TextBox>

                    <Label Grid.Column="1">Mode</Label>
                    <TextBox Grid.Column="2" x:Name="txtMode"></TextBox>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="Background" Value="RoyalBlue"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="2,2,2,2"/>
                        <Setter Property="Padding" Value="0,0,0,0"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Background="Brown">Message</Label>
                <Label Grid.Row="1" Grid.Column="0">Solution</Label>

                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtMessage" Foreground="Yellow"></TextBox>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSolution"></TextBox>
            </Grid>

        </Grid>
        <Border Grid.Column="1" BorderBrush="#bbbbbb" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" FontSize="24" FontWeight="Bold" BorderBrush="#bbbbbb" BorderThickness="2"
                        Foreground="DodgerBlue"
                   VerticalContentAlignment="Center" HorizontalContentAlignment="Center">Recent Alarms</Label>

                <UniformGrid Grid.Row="1" Name="ugridJamList" Rows="10">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" >
                            <Setter Property="FontSize" Value="24"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="DodgerBlue"/>
                        </Style>
                    </UniformGrid.Resources>

                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Page>

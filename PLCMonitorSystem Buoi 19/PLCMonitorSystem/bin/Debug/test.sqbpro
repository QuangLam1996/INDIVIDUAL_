 name="SQL 1*">CREATE TABLE &quot;nhietdo&quot; (
	&quot;id&quot;	INTEGER NOT NULL UNIQUE,
	&quot;giatri&quot;	REAL NOT NULL DEFAULT 0,
	&quot;thoigian&quot;	TEXT NOT NULL DEFAULT 07102025,
	PRIMARY KEY(&quot;id&quot; AUTOINCREMENT)
);
INSERT INTO apsuat (giatri, thoigian)
VALUES(456,'07_10_2025');

INSERT INTO nhietdo (giatri, thoigian)
VALUES(111,'07_10_2025');

SELECT * FROM apsuat;
SELECT giatri FROM apsuat;
SELECT * FROM apsuat WHERE id&lt;=5;
SELECT giatri FROM apsuat WHERE giatri&gt;=1333;
SELECT * FROM apsuat WHERE (id=2 OR id= 5);
SELECT * FROM apsuat ORDER BY id ASC;
SELECT * FROM apsuat ORDER BY id DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
